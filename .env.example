# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# NEIS 오픈 API 키 (https://open.neis.go.kr) - 미설정 시 내장 고품질 데이터셋으로 즉시 동작
NEIS_API_KEY="your_neis_api_key_here"

# TMAP Open API 키 (https://tmapapi.sktelecom.com) - 미설정 시 OSRM/지오코딩 엔진으로 자동 대체 동작
NEXT_PUBLIC_TMAP_APPKEY="your_tmap_appkey_here"
TMAP_SERVER_API_KEY="your_tmap_server_api_key_here"

# Supabase Auth & Database 설정 (https://supabase.com) - 브라우저 설정 모달에서도 입력 가능
NEXT_PUBLIC_SUPABASE_URL="https://your-project-id.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your_supabase_anon_key_here"
SUPABASE_SERVICE_ROLE_KEY="your_supabase_service_role_key_here"
